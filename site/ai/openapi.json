{
  "openapi": "3.1.0",
  "info": {
    "title": "VPS Price Watch read-only content",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://vpspricewatch.com"
    }
  ],
  "paths": {
    "/api/content": {
      "get": {
        "operationId": "searchPublishedContent",
        "summary": "Search published content snapshots",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Published page matches, not checkout verification",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string",
                            "format": "uri"
                          },
                          "title": {
                            "type": "string"
                          },
                          "excerpt": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/content": {
      "get": {
        "operationId": "readWithAgentCredential",
        "security": [
          {
            "agentOAuth": [
              "content:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Read-only published page matches"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Operational read-only service"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "agentOAuth": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://vpspricewatch.com/oauth/token",
            "scopes": {
              "content:read": "Read public published content only"
            }
          }
        }
      }
    }
  }
}